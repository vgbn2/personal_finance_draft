[Unit]
Description=Sovereign central host fast-forward update
Documentation=file://@REPO_ROOT@/infra/docker/DEPLOY.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@DEPLOY_USER@
Group=@DEPLOY_GROUP@
SupplementaryGroups=docker
WorkingDirectory=@REPO_ROOT@
Environment=SOVEREIGN_NODE_BIN=@NODE_BIN@
Environment=SOVEREIGN_CENTRAL_ENV_FILE=@REPO_ROOT@/.env.central
ExecStart=@REPO_ROOT@/infra/docker/update-central-host.sh
TimeoutStartSec=30min
Nice=10

[Install]
WantedBy=multi-user.target
