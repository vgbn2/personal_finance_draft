# syntax=docker/dockerfile:1
# Sovereign Platform — All-in-One Unified Production Container
# Integrates: C++20 release build, CMake, Node.js 22 LTS, React 19 Frontend, Alpaca Paper Loop, and headless Wine 9 / MT5 bridge (port 8282)

ARG SOVEREIGN_SOURCE_REVISION=unverified
ARG SOVEREIGN_SOURCE_TREE=unverified

# --- STAGE 1: C++20 Core & Frontend Build ---
FROM node:22-bookworm AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY backend/api/package*.json ./backend/api/
RUN cd backend/api && npm ci --ignore-scripts --omit=dev

COPY backend/gateway/package*.json ./backend/gateway/
RUN cd backend/gateway && npm ci --ignore-scripts --omit=dev

COPY Frontend/dashboard/package*.json ./Frontend/dashboard/
RUN cd Frontend/dashboard && npm ci --ignore-scripts

COPY . .
RUN cd Frontend/dashboard && npm run build

RUN cmake -S backend/core -B backend/core/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DSOVEREIGN_ENABLE_ONNX_RUNTIME=ON \
    && cmake --build backend/core/build --parallel --target sovereign_wealth

# --- STAGE 2: Unified Runtime with Headless Wine 9 & Node 22 LTS ---
FROM ubuntu:22.04 AS runtime

ARG SOVEREIGN_SOURCE_REVISION
ARG SOVEREIGN_SOURCE_TREE

LABEL org.opencontainers.image.source="https://github.com/vgbn2/personal_finance_draft" \
      org.opencontainers.image.description="Sovereign Trading Platform All-in-One Container" \
      org.opencontainers.image.licenses="SEE LICENSE IN LICENSE" \
      org.opencontainers.image.revision="${SOVEREIGN_SOURCE_REVISION}" \
      io.sovereign.source-tree="${SOVEREIGN_SOURCE_TREE}" \
      io.sovereign.build-contract="all-in-one"

ENV DEBIAN_FRONTEND=noninteractive \
    WINEARCH=win64 \
    WINEPREFIX=/opt/mt5/.wine \
    DISPLAY=:99 \
    MT5_HOME=/opt/mt5 \
    NODE_ENV=production \
    SOVEREIGN_WEB_HOST=0.0.0.0 \
    SOVEREIGN_WEB_PORT=8787 \
    SOVEREIGN_BACKEND_BIN=/app/backend/core/build/sovereign_wealth

# Install Wine Staging, Xvfb, and Node.js 22 LTS
RUN dpkg --add-architecture i386 && \
    mkdir -pm1777 /tmp/.X11-unix && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl ca-certificates gnupg2 software-properties-common \
        xvfb cabextract procps netcat-openbsd winetricks libgomp1 libsqlite3-0 && \
    mkdir -pm755 /etc/apt/keyrings && \
    curl -fsSL https://dl.winehq.org/wine-builds/winehq.key | gpg --dearmor -o /etc/apt/keyrings/winehq-archive.key && \
    curl -fsSL https://dl.winehq.org/wine-builds/ubuntu/dists/jammy/winehq-jammy.sources -o /etc/apt/sources.list.d/winehq-jammy.sources && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get update && \
    apt-get install -y --install-recommends winehq-staging nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Setup non-root sovereign user (UID 1000)
RUN useradd -m -u 1000 -d /home/sovereign sovereign && \
    mkdir -p /opt/mt5/terminal /opt/mt5/config /opt/mt5/.wine /app/storage /app/workspace && \
    chown -R sovereign:sovereign /opt/mt5 /app /home/sovereign

USER sovereign
WORKDIR /opt/mt5

# Initialize Wine headless prefix and disable audio driver loops
RUN Xvfb :99 -screen 0 1024x768x16 -nolisten tcp -ac +extension GLX & \
    XVFB_PID=$! && \
    sleep 2 && \
    WINEDEBUG=-all wineboot --init && \
    wineserver -w && \
    WINEDEBUG=-all wine reg add "HKEY_CURRENT_USER\Software\Wine\Drivers" /v Audio /t REG_SZ /d "" /f && \
    wineserver -w && \
    kill $XVFB_PID 2>/dev/null || true

WORKDIR /app

# Copy built application assets and dependencies
COPY --from=build --chown=sovereign:sovereign /app/package.json /app/package-lock.json ./
COPY --from=build --chown=sovereign:sovereign /app/node_modules ./node_modules
COPY --from=build --chown=sovereign:sovereign /app/backend/api ./backend/api
COPY --from=build --chown=sovereign:sovereign /app/backend/cli ./backend/cli
COPY --from=build --chown=sovereign:sovereign /app/backend/gateway ./backend/gateway
COPY --from=build --chown=sovereign:sovereign /app/backend/mcp_server ./backend/mcp_server
COPY --from=build --chown=sovereign:sovereign /app/backend/scripts ./backend/scripts
COPY --from=build --chown=sovereign:sovereign /app/backend/core/build ./backend/core/build
COPY --from=build --chown=sovereign:sovereign /app/Frontend/dashboard/dist ./Frontend/dashboard/dist
COPY --from=build --chown=sovereign:sovereign /app/shared ./shared
COPY --from=build --chown=sovereign:sovereign /app/config ./config
COPY --from=build --chown=sovereign:sovereign /app/scripts ./scripts
COPY --from=build --chown=sovereign:sovereign /app/tools/mt5 /opt/mt5/terminal/MQL5/Experts
COPY --chown=sovereign:sovereign infra/docker/entrypoint.allinone.sh /app/entrypoint.sh

USER root
RUN chmod +x /app/entrypoint.sh
USER sovereign

EXPOSE 8787 8282

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:8787/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["node", "backend/api/app.js"]
