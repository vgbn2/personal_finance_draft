{
  "configurations": [
    {
      "name": "Linux",
      "compileCommands": "${workspaceFolder}/backend/core/build/compile_commands.json",
      "compilerPath": "/usr/bin/c++",
      "compilerArgs": [
        "-std=c++20"
      ],
      "defines": [
        "__cpp_lib_span=202002L",
        "__cpp_concepts=201907L",
        "__cplusplus=202002L"
      ],
      "includePath": [
        "${workspaceFolder}/backend/core/src/**",
        "${workspaceFolder}/**"
      ],
      "cppStandard": "c++20",
      "cStandard": "c17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}
