      "fixed_overrides": {"LIVE_TRADING": "false", "NODE_OPTIONS": "--max-old-space-size=6144", "SOVEREIGN_DEPLOYMENT_PROFILE": "central-host", "SOVEREIGN_EXECUTION_AUTHORIZED": "false", "SOVEREIGN_RUNTIME_MODE": "cloud-compute"},
      "mounts": ["../../storage:/app/storage"],
      "forbidden_environment_classes": ["central", "execution"]
    },
    "portfolio-monitor": {
