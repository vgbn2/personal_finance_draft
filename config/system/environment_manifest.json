      "forbidden_environment_classes": ["private", "execution"]
    },
    "bot": {
      "surface": "compose_paper_bot",
      "profile": "central-host",
      "compose_profile": "paper",
      "command_identity": "node backend/cli/sovereign_cli.js run bot paper --strategy low_prob_dip",
      "required_keys": [],
      "optional_keys": ["SOVEREIGN_USER_SETTINGS_PATH"],
      "defaulted_keys": ["SOVEREIGN_ADMIN_BOT_INTERVAL_MIN", "SOVEREIGN_GLOBAL_BOT_INTERVAL_MIN"],
      "fixed_overrides": {"LIVE_TRADING": "false", "SOVEREIGN_DEPLOYMENT_PROFILE": "central-host", "SOVEREIGN_EXECUTION_AUTHORIZED": "false", "SOVEREIGN_RUNTIME_MODE": "cloud-compute"},
      "mounts": ["../../storage:/app/storage"],
      "forbidden_environment_classes": ["private", "central", "execution"]
    },
    "backfill": {
      "surface": "compose_backfill",
      "profile": "central-host",
      "compose_profile": "writer",
      "command_identity": "node backend/cli/sovereign_cli.js backfill-daemon",
