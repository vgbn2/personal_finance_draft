      "required_keys": ["SOVEREIGN_API_TOKEN", "SOVEREIGN_CLIENT_TOKEN"],
      "optional_keys": ["SOVEREIGN_ALLOWED_ORIGINS", "SOVEREIGN_AUTH_SESSION_REGISTRY", "SOVEREIGN_SERVICE_PRINCIPALS_PATH", "SOVEREIGN_SUPABASE_URL", "SOVEREIGN_SUPABASE_PUBLISHABLE_KEY", "SOVEREIGN_SUPABASE_SECRET_KEY"],
      "defaulted_keys": ["SOVEREIGN_API_MAX_BODY_BYTES", "SOVEREIGN_AUTH_SESSION_MAX_ENTRIES", "SOVEREIGN_AUTH_SESSION_TRACKING", "SOVEREIGN_AUTH_SESSION_TTL_DAYS", "SOVEREIGN_DEFAULT_USER_ROLE", "SOVEREIGN_IP_CHANGE_POLICY", "SOVEREIGN_TRUST_PROXY", "SOVEREIGN_USER_ROLE_MAP"],
      "fixed_overrides": {"LIVE_TRADING": "false", "SOVEREIGN_DEPLOYMENT_PROFILE": "central-host", "SOVEREIGN_EXECUTION_AUTHORIZED": "false", "SOVEREIGN_RUNTIME_MODE": "cloud-compute", "SOVEREIGN_WEB_HOST": "0.0.0.0", "SOVEREIGN_WEB_PORT": "8787", "SOVEREIGN_CACHE_TTL_MS": "30000", "SOVEREIGN_CACHE_MAX_ENTRIES": "100"},
