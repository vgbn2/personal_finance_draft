      "optional_keys": ["HOST_BACKUP_ROOT"],
      "defaulted_keys": ["HOST_BACKUP_INTERVAL_SECS", "HOST_BACKUP_MAX_COUNT", "HOST_BACKUP_RETENTION_DAYS"],
      "fixed_overrides": {"LIVE_TRADING": "false", "SOVEREIGN_DEPLOYMENT_PROFILE": "central-host", "SOVEREIGN_EXECUTION_AUTHORIZED": "false", "SOVEREIGN_RUNTIME_MODE": "cloud-compute"},
      "mounts": ["../../storage:/app/storage"],
      "forbidden_environment_classes": ["private", "central", "execution"]
    },
    "polymarket-research": {
      "surface": "compose_polymarket_research",
      "profile": "central-host",
      "compose_profile": "research",
      "command_identity": "node backend/cli/sovereign_cli.js polymarket history schedule",
      "required_keys": ["POLYMARKET_RESEARCH_SCOPE_FILE"],
      "optional_keys": [],
      "defaulted_keys": ["POLYMARKET_RESEARCH_INTERVAL_SECS", "POLYMARKET_RESEARCH_MAX_ARCHIVE_BYTES", "POLYMARKET_RESEARCH_MAX_ROWS_PER_TOKEN", "POLYMARKET_RESEARCH_MAX_TOKENS", "POLYMARKET_RESEARCH_RETENTION_DAYS"],
      "fixed_overrides": {"LIVE_TRADING": "false", "SOVEREIGN_DEPLOYMENT_PROFILE": "central-host", "SOVEREIGN_EXECUTION_AUTHORIZED": "false", "SOVEREIGN_RUNTIME_MODE": "cloud-compute"},
      "mounts": ["../../storage:/app/storage"],
      "forbidden_environment_classes": ["private", "central", "execution"]
    }
