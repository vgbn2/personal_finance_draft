# Data/research-only environment for the single-writer central host.
# Copy to .env.central, chmod 600, and never add execution PINs or private wallet/L2 keys.
SOVEREIGN_DEPLOYMENT_PROFILE=central-host
SOVEREIGN_RUNTIME_MODE=cloud-compute
LIVE_TRADING=false
SOVEREIGN_EXECUTION_AUTHORIZED=false
SOVEREIGN_API_TOKEN=
SOVEREIGN_CLIENT_TOKEN=
SOVEREIGN_WEB_HOST=0.0.0.0
SOVEREIGN_WEB_PORT=8787
SOVEREIGN_WEB_BIND=127.0.0.1
SOVEREIGN_ALLOWED_ORIGINS=
SOVEREIGN_API_MAX_BODY_BYTES=1048576
SOVEREIGN_SERVICE_PRINCIPALS_PATH=/app/storage/runtime/service_principals.json
SOVEREIGN_DEFAULT_USER_ROLE=viewer
# Optional trusted server-side JSON map, for example: {"user-uuid":"owner"}
SOVEREIGN_USER_ROLE_MAP={}
SOVEREIGN_AUTH_SESSION_TRACKING=true
SOVEREIGN_IP_CHANGE_POLICY=audit
SOVEREIGN_TRUST_PROXY=false
# Bot interval policy, in minutes. The effective interval is the maximum of
# global minimum, personal setting/request, and admin host minimum.
SOVEREIGN_GLOBAL_BOT_INTERVAL_MIN=1
SOVEREIGN_ADMIN_BOT_INTERVAL_MIN=1
BACKFILL_INTERVAL_SECS=1800
SOVEREIGN_TS_WRITE_LOCK_TIMEOUT_MS=30000
SOVEREIGN_TS_WRITE_LOCK_STALE_MS=300000

# Data providers. Alpaca should remain on its paper endpoint on the central research host.
# Live credentials are intentionally absent from the central-host template.
# The portfolio monitor and backfill writer use only Alpaca Paper credentials.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
FRED_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
KALSHI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional server-side research persistence/auth. Keep RLS and secret custody reviewed separately.
SOVEREIGN_SUPABASE_URL=
SOVEREIGN_SUPABASE_PUBLISHABLE_KEY=
SOVEREIGN_SUPABASE_SECRET_KEY=

# Bounded monitoring/backups. These do not enable execution.
PORTFOLIO_MONITOR_SCOPE=both
PORTFOLIO_MONITOR_ALPACA_SCOPE=paper
PORTFOLIO_MONITOR_INTERVAL_SECS=60
PORTFOLIO_MONITOR_TIMEOUT_MS=45000
HOST_HEALTH_INTERVAL_SECS=300
HOST_HEALTH_TS_MAX_AGE_MIN=120
HOST_HEALTH_MIN_FREE_GB=10
HOST_HEALTH_MIN_FREE_PERCENT=10
HOST_BACKUP_INTERVAL_SECS=86400
HOST_BACKUP_ROOT=/app/storage/backups/host
HOST_BACKUP_RETENTION_DAYS=30
HOST_BACKUP_MAX_COUNT=14
POLYMARKET_RESEARCH_SCOPE_FILE=
POLYMARKET_RESEARCH_INTERVAL_SECS=300
POLYMARKET_RESEARCH_MAX_TOKENS=20
POLYMARKET_RESEARCH_RETENTION_DAYS=30
POLYMARKET_RESEARCH_MAX_ROWS_PER_TOKEN=5000
POLYMARKET_RESEARCH_MAX_ARCHIVE_BYTES=5368709120
