                "data": {
                    "code": "/* Find 8 Profiles with Photos & Filter Names */\nconst profiles = document.querySelectorAll('.user-card'); // Adjust selector\nlet validProfiles = [];\n\nfor (let p of profiles) {\n  const name = p.querySelector('.user-name')?.innerText || '';\n  const hasPhoto = p.querySelector('img.avatar') !== null;\n  \n  // Filter: No [] and Normal Chars\n  if (hasPhoto && !name.includes('[') && !name.includes(']')) {\n    const link = p.querySelector('a')?.href;\n    if (link) validProfiles.push(link);\n  }\n  if (validProfiles.length >= 8) break;\n}\n\nreturn validProfiles;",
                    "description": "JS: Find 8 Valid Profiles",
                    "context": "page",
                    "everyNewTab": false,
                    "timeout": 5000
