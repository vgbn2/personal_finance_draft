# ─── Safety ───────────────────────────────
DEMO_ONLY=true

# ─── ZMQ Bridge ──────────────────────────
ZMQ_ADDRESS=tcp://127.0.0.1:5559

# ─── TimescaleDB ─────────────────────────
TIMESCALE_DSN=postgresql://postgres:postgres@localhost:5432/sentinel

# ─── AI Model ────────────────────────────
ONNX_MODEL_PATH=models/trade_scorer.onnx

# ─── Strategy ──────────────────────────────
SCALP_MODE=true # Set to true for M1/M5 scalping
MAX_RUNTIME_HOURS=3 # Auto-shutdown after X hours (0 = infinite)

