# Production Environment Configuration Template
# Copy this file and customize for your environment

# ============================================
# Application Settings
# ============================================
export ENVIRONMENT=production
export APP_NAME=polymarket-bot
export LOG_LEVEL=INFO
export PYTHONUNBUFFERED=1

# ============================================
# Docker/Container Registry
# ============================================
export REGISTRY=ghcr.io
export IMAGE_NAME=${REGISTRY}/your-org/polymarket
export IMAGE_TAG=latest

# ============================================
# Kubernetes Settings
# ============================================
export KUBE_NAMESPACE=polymarket-production
export KUBE_CONTEXT=production-cluster
export REPLICAS_BOT=1
export REPLICAS_WEB=2
export REPLICAS_TRACKERS=1

# ============================================
# Resource Limits
# ============================================
export BOT_MEMORY_REQUEST=256Mi
export BOT_MEMORY_LIMIT=512Mi
export BOT_CPU_REQUEST=250m
export BOT_CPU_LIMIT=500m

export WEB_MEMORY_REQUEST=256Mi
export WEB_MEMORY_LIMIT=512Mi
export WEB_CPU_REQUEST=250m
export WEB_CPU_LIMIT=500m

export TRACKER_MEMORY_REQUEST=128Mi
export TRACKER_MEMORY_LIMIT=256Mi
export TRACKER_CPU_REQUEST=100m
export TRACKER_CPU_LIMIT=200m

# ============================================
# Polymarket API Settings
# ============================================
export POLYMARKET_API_URL=https://api.polymarket.com
export POLYMARKET_WS_URL=wss://ws.polymarket.com

# Trading Parameters
export MIN_MERGE_SIZE=1.0
export TRADE_INTERVAL=30
export MAX_POSITION_SIZE=250
export MIN_ORDER_SIZE=1
export MAX_SPREAD=10
export VOLATILITY_THRESHOLD=0.05

# Risk Management
export STOP_LOSS_THRESHOLD=-5.0
export TAKE_PROFIT_THRESHOLD=2.0
export SPREAD_THRESHOLD=0.03
export SLEEP_PERIOD=2

# ============================================
# Database Settings (if needed)
# ============================================
export DATABASE_HOST=your-db-host
export DATABASE_PORT=5432
export DATABASE_NAME=polymarket_prod
export DATABASE_USER=polymarket
# Database password should be in secrets

# ============================================
# Monitoring & Observability
# ============================================
export ENABLE_METRICS=true
export METRICS_PORT=9090
export PROMETHEUS_URL=http://prometheus:9090
export GRAFANA_URL=http://grafana:3000

# ============================================
# Alerting
# ============================================
export ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
export ALERT_EMAIL=alerts@example.com

# ============================================
# Backup & Recovery
# ============================================
export BACKUP_ENABLED=true
export BACKUP_INTERVAL=daily
export BACKUP_RETENTION_DAYS=30
export BACKUP_BUCKET=s3://polymarket-backups

# ============================================
# Security
# ============================================
export ENABLE_TLS=true
export CERT_MANAGER_ISSUER=letsencrypt-prod
export ALLOWED_ORIGINS=https://polymarket.example.com

# ============================================
# Feature Flags
# ============================================
export ENABLE_AUTO_TRADING=true
export ENABLE_PAPER_TRADING=false
export ENABLE_POSITION_MERGING=true
export ENABLE_RISK_MANAGEMENT=true

# ============================================
# External Services
# ============================================
export FRED_API_KEY=your-fred-api-key
export BINANCE_API_URL=https://api.binance.com
export NHC_DATA_URL=https://www.nhc.noaa.gov/data/
