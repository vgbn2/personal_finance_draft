# Staging Environment Configuration Template

# ============================================
# Application Settings
# ============================================
export ENVIRONMENT=staging
export APP_NAME=polymarket-bot
export LOG_LEVEL=DEBUG
export PYTHONUNBUFFERED=1

# ============================================
# Docker/Container Registry
# ============================================
export REGISTRY=ghcr.io
export IMAGE_NAME=${REGISTRY}/your-org/polymarket
export IMAGE_TAG=staging-latest

# ============================================
# Kubernetes Settings
# ============================================
export KUBE_NAMESPACE=polymarket-staging
export KUBE_CONTEXT=staging-cluster
export REPLICAS_BOT=1
export REPLICAS_WEB=1
export REPLICAS_TRACKERS=1

# ============================================
# Resource Limits (Lower for staging)
# ============================================
export BOT_MEMORY_REQUEST=128Mi
export BOT_MEMORY_LIMIT=256Mi
export BOT_CPU_REQUEST=100m
export BOT_CPU_LIMIT=250m

export WEB_MEMORY_REQUEST=128Mi
export WEB_MEMORY_LIMIT=256Mi
export WEB_CPU_REQUEST=100m
export WEB_CPU_LIMIT=250m

export TRACKER_MEMORY_REQUEST=64Mi
export TRACKER_MEMORY_LIMIT=128Mi
export TRACKER_CPU_REQUEST=50m
export TRACKER_CPU_LIMIT=100m

# ============================================
# Polymarket API Settings
# ============================================
export POLYMARKET_API_URL=https://api.polymarket.com
export POLYMARKET_WS_URL=wss://ws.polymarket.com

# Trading Parameters (Conservative for staging)
export MIN_MERGE_SIZE=1.0
export TRADE_INTERVAL=60
export MAX_POSITION_SIZE=50
export MIN_ORDER_SIZE=1
export MAX_SPREAD=10
export VOLATILITY_THRESHOLD=0.05

# Risk Management (More conservative)
export STOP_LOSS_THRESHOLD=-3.0
export TAKE_PROFIT_THRESHOLD=1.5
export SPREAD_THRESHOLD=0.03
export SLEEP_PERIOD=4

# ============================================
# Database Settings
# ============================================
export DATABASE_HOST=your-staging-db-host
export DATABASE_PORT=5432
export DATABASE_NAME=polymarket_staging
export DATABASE_USER=polymarket_staging

# ============================================
# Monitoring & Observability
# ============================================
export ENABLE_METRICS=true
export METRICS_PORT=9090

# ============================================
# Feature Flags (Enable testing features)
# ============================================
export ENABLE_AUTO_TRADING=false
export ENABLE_PAPER_TRADING=true
export ENABLE_POSITION_MERGING=true
export ENABLE_RISK_MANAGEMENT=true
export ENABLE_DEBUG_LOGGING=true

# ============================================
# External Services
# ============================================
export FRED_API_KEY=your-fred-api-key
export BINANCE_API_URL=https://testnet.binance.vision
