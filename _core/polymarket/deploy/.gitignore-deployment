# Deployment Pipeline .gitignore

# Environment files (contain secrets)
.env
.env.*
!.env.*.template

# Kubernetes secrets (contain sensitive data)
k8s/secrets-*.yml
!k8s/secrets-template.yml

# Backup files
backups/
*.backup
*.bak

# Terraform state files (if using Terraform)
*.tfstate
*.tfstate.*
.terraform/

# Logs
*.log
logs/

# Monitoring data
monitoring/data/
monitoring/grafana/data/
monitoring/prometheus/data/

# Docker volumes
volumes/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Kubeconfig (should use system config)
kubeconfig
*.kubeconfig
kube-config*

# Helm
charts/*.tgz

# Temporary files
tmp/
temp/
*.tmp

# Local development
.local/
local/

# Credentials
credentials.json
service-account.json
*.pem
*.key
*.crt
!*.template.key

# Node modules (if any JS tooling)
node_modules/

# Database
*.db
*.sqlite
*.sqlite3

# Position tracking data (may contain sensitive trading info)
positions/*.json
!positions/.gitkeep

# API keys and tokens
api_keys.txt
tokens.txt

# Docker
docker-compose.override.yml
