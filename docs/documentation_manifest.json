    "id_pattern": "^atlas\\.(algorithm|structure|protocol|topology)\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)+$",
    "working_tree_revision": "working-tree"
  },
  "status_definitions": {
    "canonical": "Current source-centered documentation for normal developer and operator use.",
    "supporting": "Useful context that does not own the canonical contract.",
    "needs_refresh": "Retained and discoverable, but known to contain stale or incomplete claims.",
    "historical": "Dated evidence or superseded material; never current truth without source revalidation."
