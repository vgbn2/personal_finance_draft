{
  "name": "personal_finance",
  "version": "1.0.0",
  "description": "Sovereign is an active local trading research prototype with ingestion, validation, research/backtest commands, C++ backend inspection, and a local web/API dashboard bridge.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "fixtures:refresh:btc": "node backend/scripts/dev/refresh_real_bars_fixture.js",
    "models:parity": "node backend/scripts/dev/model_registry_parity.js",
    "native:doctor": "node backend/scripts/dev/native_toolchain_check.js",
    "host:prepare-central-env": "node backend/scripts/ops/prepare_central_env.js",
    "host:monitor": "bash backend/scripts/ops/host_resource_monitor.sh",
    "native:build": "cmake -S backend/core -B backend/core/build -DCMAKE_BUILD_TYPE=Release -DSOVEREIGN_ENABLE_ONNX_RUNTIME=OFF && cmake --build backend/core/build --config Release --parallel",
    "probe:backfill": "node backend/scripts/dev/parallel_backfill_probe.js",
    "test": "node tests/run_node_tests.js",
    "test:prepare": "node backend/scripts/dev/seed_master_fixture.js",
    "test:core": "npm run test:prepare && npm run native:build && ctest --test-dir backend/core/build -C Release --output-on-failure",
    "setup:mcp": "node scripts/setup_mcp.js",
    "test:api": "node --test --test-concurrency=1 backend/api/tests/api.test.js backend/api/tests/client_api.test.js backend/api/tests/access_control.test.js backend/api/tests/auth_session_registry.test.js backend/api/tests/correlation_contract.test.js backend/api/tests/dashboard_contract.test.js backend/api/tests/charts.test.js backend/api/tests/ttl_cache.test.js",
    "test:contracts": "node --test --test-concurrency=1 backend/api/tests/api.test.js backend/api/tests/client_api.test.js backend/api/tests/access_control.test.js backend/api/tests/auth_session_registry.test.js backend/api/tests/dashboard_contract.test.js tests/scripts/data/cache/macro_history_helpers.test.js tests/scripts/data/cache/cache_contract.test.js tests/scripts/data/cache/append_only_segments.test.js tests/scripts/data/cache/ts_latest_record.test.js tests/scripts/data/cache/market_monitor_snapshot.test.js tests/scripts/data/backfill/backfill_daemon.test.js tests/scripts/architecture/auth/access_policy.test.js tests/scripts/architecture/deployment/deployment_profile.test.js tests/scripts/architecture/settings/interval_policy.test.js tests/scripts/architecture/settings/runner_interval_contract.test.js tests/scripts/architecture/data_storage/macro_ingestion_contract.test.js tests/scripts/architecture/data_storage/macro_store_contract.test.js tests/scripts/architecture/cli/core/config_integrity.test.js tests/scripts/architecture/cli/core/deployment_manifest_contract.test.js tests/scripts/architecture/data_storage/supabase_route_contract.test.js tests/scripts/architecture/data_storage/dashboard_session_contract.test.js tests/scripts/architecture/tui_components/tui_search_contract.test.js",
    "test:structure": "node --test tests/scripts/architecture/cli/core/structure_contract.test.js",
    "test:data": "node --test tests/scripts/data/backfill/backfill_regression.test.js tests/scripts/lib/indicators.data_flow.test.js tests/scripts/architecture/cli/core/config_integrity.test.js",
    "test:deploy": "node --test tests/scripts/architecture/cli/core/deployment_manifest_contract.test.js",
    "test:macro": "node --test tests/scripts/data/cache/macro_history_helpers.test.js tests/scripts/architecture/data_storage/macro_ingestion_contract.test.js tests/scripts/architecture/data_storage/macro_store_contract.test.js",
    "test:secrets": "node backend/scripts/dev/secret_pattern_check.js",
    "hygiene": "node scripts/dev/check_hygiene.js",
    "bundle": "node scripts/dev/make_bundle.js",
    "verify:strict": "npm run test:api && npm run test:contracts && npm run test:secrets && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bin": {
    "sovereign": "backend/cli/sovereign_cli.js"
  },
  "imports": {
    "#shared/*": "./shared/lib/*.js",
    "#scripts/*": "./backend/scripts/data_ops/*.js",
    "#native/*": "./native/pkg/*.js"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^3.1.3",
    "@mathieuc/tradingview": "git+https://github.com/Mathieu2301/TradingView-API.git#574a9948b2adb3396b934c612f58d2ab103a6915",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@polymarket/clob-client-v2": "^1.0.6",
    "@supabase/supabase-js": "^2.106.2",
    "@types/node": "^25.9.1",
    "ethers": "^5.8.0",
    "ink": "^7.1.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "onnxruntime-node": "^1.27.0",
    "react": "^19.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "viem": "^2.52.2"
  }
}
