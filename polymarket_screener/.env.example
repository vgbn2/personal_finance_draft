# ─── Polymarket ───
POLY_API_KEY=your_polymarket_api_key_here
POLY_API_SECRET=your_polymarket_api_secret_here
POLY_PRIVATE_KEY=your_eth_private_key_for_eip712_signing

# ─── Binance ───
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ─── Deribit ───
DERIBIT_CLIENT_ID=your_deribit_client_id_here
DERIBIT_CLIENT_SECRET=your_deribit_client_secret_here

# ─── MongoDB ───
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/poly_screener

# ─── Macro Data ───
FRED_API_KEY=your_fred_api_key_here
COINGLASS_API_KEY=your_coinglass_api_key_here

# ─── Engine Settings ───
ENGINE_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
