{
  "name": "personal_finance_draft",
  "version": "1.0.0",
  "description": "Sovereign is an active local trading research prototype with ingestion, validation, research/backtest commands, C++ backend inspection, and a local web/API dashboard bridge.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "fixtures:refresh:btc": "node backend/scripts/dev/refresh_real_bars_fixture.js",
    "models:parity": "node backend/scripts/dev/model_registry_parity.js",
    "native:doctor": "node backend/scripts/dev/native_toolchain_check.js",
    "probe:backfill": "node backend/scripts/dev/parallel_backfill_probe.js",
    "test": "node tests/run_node_tests.js",
    "test:api": "node --test tests/web/api.test.js tests/web/dashboard_contract.test.js tests/web/charts.test.js",
    "test:contracts": "node --test tests/web/api.test.js tests/web/dashboard_contract.test.js tests/scripts/macro_history_helpers.test.js tests/scripts/cache_contract.test.js tests/scripts/macro_ingestion_contract.test.js tests/scripts/macro_store_contract.test.js tests/scripts/config_integrity.test.js tests/scripts/deployment_manifest_contract.test.js tests/scripts/supabase_route_contract.test.js",      
    "test:data": "node --test tests/scripts/backfill_regression.test.js tests/scripts/lib/indicators.data_flow.test.js tests/scripts/config_integrity.test.js",
    "test:deploy": "node --test tests/scripts/deployment_manifest_contract.test.js",
    "test:macro": "node --test tests/scripts/macro_history_helpers.test.js tests/scripts/macro_ingestion_contract.test.js tests/scripts/macro_store_contract.test.js",
    "verify:strict": "npm run test:contracts && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@types/node": "^25.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
