# MetaTrader 5 Configuration
# Obtain your Terminal ID from the MT5 data directory (File -> Open Data Folder)
MT5_TERMINAL_ID=D0E8209F77C8CF37AD8BF550E51FF075
MT5_METAEDITOR_PATH=C:\Program Files\MetaTrader 5\MetaEditor64.exe

# Quote Paths
HEADWAY_MT5_QUOTES_PATH=
SOVEREIGN_HEADWAY_MT5_QUOTES_PATH=

# Alpaca REST (US stocks and crypto)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Gate.io REST (crypto)
GATEIO_API_KEY=
GATEIO_API_SECRET=
GATEIO_API_PASSPHRASE=
GATEIO_BASE_URL=https://api.gateio.ws

# Data Provider API Keys
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_ACCESS_TOKEN=
FRED_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
KALSHI_API_KEY=
TRUFLATION_API_KEY=
GLASSNODE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
SOVEREIGN_API_TOKEN=

# Supabase Database/Auth
# Publishable keys are safe for browser clients when RLS is enabled.
SOVEREIGN_SUPABASE_URL=
SOVEREIGN_SUPABASE_PUBLISHABLE_KEY=
# Secret keys are server-only and required for ingest-time writes.
SOVEREIGN_SUPABASE_SECRET_KEY=

# MFA Security PIN for manual trades and kill switch overrides
SOVEREIGN_TRADE_PIN=1234

# Local AI (Ollama — 100% private, no API keys)
# Install: ollama.com  →  then run: ollama pull qwen2.5-coder:7b
# Create custom model: ollama create qwen-sovereign -f Modelfile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen-sovereign

# MCP Gate — set a random string here, then add it to .mcp.json headers
# so Claude Code MCP tool calls are gated (blocked routes + field redaction)
MCP_GATE_TOKEN=

# Cloud AI: handled via Claude Code subscription (MCP tools)
# No API keys needed — Claude Code covers all AI calls

# Polymarket CLOB (Prediction Markets — Polygon mainnet)
# Private key of your Polygon wallet (used to derive L2 API credentials)
POLYMARKET_PRIVATE_KEY=
# L2 API credentials — run `polymarket derive-creds` after setting private key
POLYMARKET_API_KEY=
# Wallet address (EOA used for signing) — shown in TUI menu for reference
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Override the CLOB host (default: https://clob.polymarket.com)
POLYMARKET_CLOB_HOST=
# Deposit/proxy wallet that actually holds USDC collateral and owns orders.
# REQUIRED if you fund a Polymarket *deposit* account (Gnosis Safe) rather than
# trading directly from the signer EOA. Without it, balance/order reads resolve
# against the empty EOA and report pUSD: 0. Defaults to POLYMARKET_WALLET_ADDRESS.
POLYMARKET_FUNDER_ADDRESS=
# Signature type: 0=EOA, 1=POLY_PROXY (magic/email), 2=POLY_GNOSIS_SAFE (deposit
# wallet — the modern default). Auto-set to 2 when a funder address is present.
POLYMARKET_SIGNATURE_TYPE=
